algoritmo "Porteiro Do Evento"

// Autor : Vinycius Lopes Montero da SIlva
// Data : 14/04/2026
// Seção de Declarações 

var

   idade: inteiro

inicio

      escreva("Digite a idade: ")
      leia(idade)
      se (idade < 5) ou (idade >= 65) entao
      escreva("Entrada gratuita!")
      senao
      escreva("Visitante paga ingresso.")
      fimse
      
fimalgoritmo
